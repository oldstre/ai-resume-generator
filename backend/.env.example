# 复制为 .env 并填入真实值
APP_ENV=development

# 数据库（docker-compose 会自动设置这些）
DATABASE_URL=postgresql+asyncpg://resume:resume@localhost:39432/resume
REDIS_URL=redis://localhost:39379/0

# 跨域（前端地址）
CORS_ORIGINS=["http://localhost:39173"]

# LLM（DeepSeek）
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_ENABLED=false
LLM_TIMEOUT_SECONDS=60
RESUME_CONCURRENCY=3

# 联网搜索
TAVILY_API_KEY=tvly-your-key-here

# LangSmith 追踪（可选）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-resume-generator
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 向量嵌入
DASHSCOPE_API_KEY=sk-your-key-here
